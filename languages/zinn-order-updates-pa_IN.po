msgid "Zinn® Order Updates"
msgstr "Zinn® Order Updates"

#. Plugin URI of the plugin
#: zinn-order-updates.php
msgid "https://zinndigital.com/wordpress-plugins/zinn-order-updates"
msgstr "https://zinndigital.com/wordpress-plugins/zinn-order-updates"

#. Description of the plugin
#: zinn-order-updates.php
msgid "SMS and WhatsApp order updates for your store, sent through Zinn® Campaigns under your store's own name. Connect in one click; no keys to paste."
msgstr "ਤੁਹਾਡੇ ਸਟੋਰ ਲਈ SMS ਅਤੇ WhatsApp ਆਰਡਰ ਅੱਪਡੇਟ, ਜੋ ਤੁਹਾਡੇ ਸਟੋਰ ਦੇ ਆਪਣੇ ਨਾਮ ਹੇਠ Zinn® Campaigns ਰਾਹੀਂ ਭੇਜੇ ਜਾਂਦੇ ਹਨ। ਇੱਕ ਕਲਿੱਕ ਵਿੱਚ ਕਨੈਕਟ ਕਰੋ; ਪੇਸਟ ਕਰਨ ਲਈ ਕੋਈ ਕੁੰਜੀ ਨਹੀਂ।"

#. Author of the plugin
#: zinn-order-updates.php
msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — CEO, Zinn Digital® Ltd"

#. Author URI of the plugin
#: zinn-order-updates.php
msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

#: includes/class-zinn-order-updates-admin.php:35
msgid "Order Updates"
msgstr "ਆਰਡਰ ਅੱਪਡੇਟ"

#: includes/class-zinn-order-updates-admin.php:86
msgid "Your store is connected to Zinn® Campaigns."
msgstr "ਤੁਹਾਡਾ ਸਟੋਰ Zinn® Campaigns ਨਾਲ ਕਨੈਕਟ ਹੈ।"

#: includes/class-zinn-order-updates-admin.php:87
msgid "Your store is disconnected. No messages will be sent."
msgstr "ਤੁਹਾਡਾ ਸਟੋਰ ਡਿਸਕਨੈਕਟ ਹੋ ਗਿਆ ਹੈ। ਕੋਈ ਸੁਨੇਹਾ ਨਹੀਂ ਭੇਜਿਆ ਜਾਵੇਗਾ।"

#: includes/class-zinn-order-updates-admin.php:88
msgid "That connection took too long or was started in another browser. Press Connect again."
msgstr "ਉਸ ਕਨੈਕਸ਼ਨ ਵਿੱਚ ਬਹੁਤ ਜ਼ਿਆਦਾ ਸਮਾਂ ਲੱਗਿਆ ਜਾਂ ਕਿਸੇ ਹੋਰ ਬ੍ਰਾਊਜ਼ਰ ਵਿੱਚ ਸ਼ੁਰੂ ਕੀਤਾ ਗਿਆ ਸੀ। ਕਿਰਪਾ ਕਰਕੇ ਦੁਬਾਰਾ ਕਨੈਕਟ ਕਰੋ ਦਬਾਓ।"

#: includes/class-zinn-order-updates-admin.php:89
msgid "Zinn® did not accept the connection. Press Connect again; if it keeps failing, contact Zinn® support."
msgstr "Zinn® ਨੇ ਕਨੈਕਸ਼ਨ ਸਵੀਕਾਰ ਨਹੀਂ ਕੀਤਾ। ਦੁਬਾਰਾ \"ਕਨੈਕਟ ਕਰੋ\" ਦਬਾਓ; ਜੇਕਰ ਇਹ ਲਗਾਤਾਰ ਅਸਫਲ ਰਹਿੰਦਾ ਹੈ, ਤਾਂ Zinn® ਸਹਾਇਤਾ ਨਾਲ ਸੰਪਰਕ ਕਰੋ।"

#: includes/class-zinn-order-updates-admin.php:90
msgid "Your site could not reach Zinn®. Check that your host allows outgoing connections, then press Connect again."
msgstr "ਤੁਹਾਡੀ ਸਾਈਟ Zinn® ਤੱਕ ਨਹੀਂ ਪਹੁੰਚ ਸਕੀ। ਜਾਂਚ ਕਰੋ ਕਿ ਤੁਹਾਡਾ ਹੋਸਟ ਆਊਟਗੋਇੰਗ ਕਨੈਕਸ਼ਨਾਂ ਦੀ ਇਜਾਜ਼ਤ ਦਿੰਦਾ ਹੈ ਜਾਂ ਨਹੀਂ, ਫਿਰ ਦੁਬਾਰਾ \"ਕਨੈਕਟ ਕਰੋ\" ਦਬਾਓ।"

#: includes/class-zinn-order-updates-admin.php:128
msgid "Send your customers SMS and WhatsApp updates about their orders, under your store's own name, paid from your Zinn® credit."
msgstr "ਆਪਣੇ ਗਾਹਕਾਂ ਨੂੰ ਉਹਨਾਂ ਦੇ ਆਰਡਰਾਂ ਬਾਰੇ ਆਪਣੀ ਦੁਕਾਨ ਦੇ ਨਾਮ ਹੇਠ SMS ਅਤੇ WhatsApp ਅੱਪਡੇਟ ਭੇਜੋ, ਜਿਸਦਾ ਭੁਗਤਾਨ ਤੁਹਾਡੇ Zinn® ਕ੍ਰੈਡਿਟ ਵਿੱਚੋਂ ਕੀਤਾ ਜਾਵੇਗਾ।"

#: includes/class-zinn-order-updates-admin.php:129
msgid "Connect opens Zinn® in this window. Sign in or create an account, approve this store, and you come straight back here. You never paste a key."
msgstr "ਕਨੈਕਟ ਕਰੋ ਇਸ ਵਿੰਡੋ ਵਿੱਚ Zinn® ਖੋਲ੍ਹਦਾ ਹੈ। ਸਾਈਨ ਇਨ ਕਰੋ ਜਾਂ ਇੱਕ ਖਾਤਾ ਬਣਾਓ, ਇਸ ਸਟੋਰ ਨੂੰ ਮਨਜ਼ੂਰੀ ਦਿਓ, ਅਤੇ ਤੁਸੀਂ ਸਿੱਧੇ ਇੱਥੇ ਵਾਪਸ ਆ ਜਾਓਗੇ। ਤੁਹਾਨੂੰ ਕਦੇ ਵੀ ਕੁੰਜੀ ਪੇਸਟ ਕਰਨ ਦੀ ਲੋੜ ਨਹੀਂ ਹੈ।"

#: includes/class-zinn-order-updates-admin.php:130
msgid "Connect to Zinn® Campaigns"
msgstr "Zinn® Campaigns ਨਾਲ ਕਨੈਕਟ ਕਰੋ"

#: includes/class-zinn-order-updates-admin.php:136
msgid "Connected, but Zinn® could not be reached just now. We will try again shortly."
msgstr "ਕਨੈਕਟ ਹੋ ਗਿਆ, ਪਰ ਹੁਣੇ Zinn® ਨਾਲ ਸੰਪਰਕ ਨਹੀਂ ਹੋ ਸਕਿਆ। ਅਸੀਂ ਜਲਦੀ ਹੀ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰਾਂਗੇ।"

#: includes/class-zinn-order-updates-admin.php:141
msgid "Store"
msgstr "ਸਟੋਰ"

#: includes/class-zinn-order-updates-admin.php:147
msgid "Connected"
msgstr "ਕਨੈਕਟ ਕੀਤਾ ਗਿਆ"

#: includes/class-zinn-order-updates-admin.php:152
msgid "Zinn® Campaigns"
msgstr "Zinn® Campaigns"

#: includes/class-zinn-order-updates-admin.php:154
msgid "Open for your account"
msgstr "ਤੁਹਾਡੇ ਖਾਤੇ ਲਈ ਖੁੱਲ੍ਹਾ ਹੈ"

#: includes/class-zinn-order-updates-admin.php:155
msgid "Not open for your account yet. Zinn® will e-mail you when it is."
msgstr "ਤੁਹਾਡੇ ਖਾਤੇ ਲਈ ਅਜੇ ਖੁੱਲ੍ਹਾ ਨਹੀਂ ਹੈ। ਤਿਆਰ ਹੋਣ 'ਤੇ Zinn® ਤੁਹਾਨੂੰ ਈਮੇਲ ਭੇਜੇਗਾ।"

#: includes/class-zinn-order-updates-admin.php:159
msgid "Disconnect"
msgstr "ਡਿਸਕਨੈਕਟ ਕਰੋ"

#: includes/class-zinn-order-updates-connect.php:77
msgid "You are not allowed to connect this store."
msgstr "ਤੁਹਾਨੂੰ ਇਸ ਸਟੋਰ ਨੂੰ ਕਨੈਕਟ ਕਰਨ ਦੀ ਇਜਾਜ਼ਤ ਨਹੀਂ ਹੈ।"

#: includes/class-zinn-order-updates-connect.php:152
msgid "You are not allowed to disconnect this store."
msgstr "ਤੁਹਾਨੂੰ ਇਸ ਸਟੋਰ ਨੂੰ ਡਿਸਕਨੈਕਟ ਕਰਨ ਦੀ ਇਜਾਜ਼ਤ ਨਹੀਂ ਹੈ।"

